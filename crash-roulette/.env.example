# ─── Solana ───────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
PROGRAM_ID=YOUR_PROGRAM_ID_HERE
# Path to your house authority keypair (generated with `solana-keygen new`)
HOUSE_KEYPAIR_PATH=~/.config/solana/devnet.json

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING
DATABASE_URL=postgresql://user:password@localhost:5432/crash_roulette
FRONTEND_URL=http://localhost:3000

# ─── Frontend (copy to web/.env.local) ───────────────────────────────────────
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_PROGRAM_ID=YOUR_PROGRAM_ID_HERE
