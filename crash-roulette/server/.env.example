# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=http://localhost:3000

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=replace_with_64_char_hex_string

# ── Database ──────────────────────────────────────────────────────────────────
# Matches docker-compose.yml defaults — change for production
DATABASE_URL=postgresql://user:password@localhost:5432/crash_roulette

# ── Solana ────────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# After `anchor build` and `anchor deploy`, paste your program ID here:
PROGRAM_ID=CRaSHRouLetteProgram111111111111111111111111

# Path to the house authority keypair JSON (Solana CLI format: array of 64 numbers)
# Generate with: solana-keygen new --outfile ~/.config/solana/devnet.json
HOUSE_KEYPAIR_PATH=~/.config/solana/devnet.json

# ── Optional ──────────────────────────────────────────────────────────────────
# Set DEBUG=1 to enable verbose Prisma query logging
DEBUG=
